# ---- Backend environment variables ----
# Copy to .env (not committed) and fill in real values.

# --- Model config ---
WHISPER_MODEL_NAME=small
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
XTTS_SPEAKER_WAV_PATH=/app/voices/reference_voice.wav

# --- RAG / vector store ---
VECTOR_DB_PATH=/app/data/chroma_db
DOCS_PATH=/app/data/documents

# --- LLM provider (whichever you use for RAG generation) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# or: ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- CORS: exact deployed frontend origin(s), comma-separated ---
# Must be the real deployed domain, not a wildcard, once you go to prod.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Hugging Face cache (should match Dockerfile) ---
HF_HOME=/app/.cache/huggingface

# --- Server ---
PORT=8000
