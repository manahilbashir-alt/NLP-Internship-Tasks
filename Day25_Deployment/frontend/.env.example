# Copy this file to .env and adjust if your backend runs somewhere
# other than the local default. Vite only reads VITE_-prefixed vars.
#
# Local development (api.py run with `uvicorn api:app --port 8000`):
VITE_API_BASE=http://127.0.0.1:8000

# If you expose the backend through ngrok / a remote host instead,
# point this at that URL, e.g.:
# VITE_API_BASE=https://your-tunnel-id.ngrok-free.dev
