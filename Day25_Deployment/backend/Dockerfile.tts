# =========================================================
# TTS Dockerfile — XTTS v2
# =========================================================

FROM python:3.11-slim AS base

# ---- System dependencies -----------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        git \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Python dependencies -----------------------------------
COPY requirements-tts.txt .

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-tts.txt

# ---- Model/cache configuration -----------------------------
ENV COQUI_TOS_AGREED=1 \
    TTS_HOME=/root/.local/share/tts \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface \
    XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# ---- Download XTTS v2 during BUILD -------------------------
# This prevents the container from downloading the model
# when the first user request arrives.
RUN python -c "from TTS.api import TTS; TTS('tts_models/multilingual/multi-dataset/xtts_v2')"

# ---- Application -------------------------------------------
COPY . .

# ---- Runtime -----------------------------------------------
EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8004/ || exit 1

CMD ["uvicorn", "tts_api:app", "--host", "0.0.0.0", "--port", "8004"]